{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Pas": {
    "PathPrefix": "",
    "PendedAutoFinalizeSeconds": 10,
    "NotificationRetrySeconds": 3,
    "NotificationMaxSeconds": 280,
    "HandshakeDelaySeconds": 1,
    "NotificationTimeoutSeconds": 15,
    "DataDir": "./data",
    "AuditEnabled": true,
    "AuthTokens": [],
    "NotificationUrlRewrites": []
  }
}
